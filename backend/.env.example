# backend/.env 로 복사해서 사용하세요. 이 파일은 커밋하되 .env 는 커밋하지 않습니다.

# --- 앱 ---
CORS_ORIGINS=*

# --- 외부 API ---
OPENAI_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
EBAY_APP_ID=

# --- Local LLM (M5, Ollama + Gemma) ---
# ollama pull gemma2:2b  후 LLM_ENABLED=true 로 바꾸면 진단 설명이 LLM으로 생성됩니다.
# 꺼져 있어도 진단은 동작하며, 설명만 템플릿으로 대체됩니다.
LLM_ENABLED=false
LLM_MODEL=gemma2:2b
OLLAMA_URL=http://127.0.0.1:11434
