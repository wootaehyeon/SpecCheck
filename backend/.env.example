# backend/.env 로 복사해서 사용하세요. 이 파일은 커밋하되 .env 는 커밋하지 않습니다.

# --- 앱 ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOCAL_AGENT_BACKEND_URL=http://127.0.0.1:8000

# --- 외부 API ---
OPENAI_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 네이버 개발자 센터에서 "검색" API를 선택한 애플리케이션의 키를 입력합니다.
# 키는 backend/.env에만 두고 Git에 올리지 않습니다. 가격 결과는 15분간 로컬 캐시됩니다.
NAVER_PRICE_CACHE_TTL_SECONDS=900
EBAY_APP_ID=

# --- 게시글 품질 평가 (KoGPT-2 perplexity) ---
# 모델은 저장소에 없으므로 경로를 직접 지정해야 합니다. 비워두면 평가를 건너뜁니다.
QUALITY_EVAL_ENABLED=false
QUALITY_MODEL_DIR=

# --- Local LLM (M5, Ollama + Gemma) ---
# ollama pull gemma3:4b 후 LLM_ENABLED=true 로 바꾸면 진단과 교체 추천 설명이 생성됩니다.
# 꺼져 있어도 판정과 후보 선택은 동작하며, 설명만 규칙 템플릿으로 대체됩니다.
LLM_ENABLED=false
LLM_MODEL=gemma3:4b
OLLAMA_URL=http://127.0.0.1:11434
LLM_TIMEOUT=12
LLM_STATUS_TIMEOUT=1.5
