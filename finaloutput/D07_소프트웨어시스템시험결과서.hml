false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>격리 경로와 허용된 실행 방식</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>으로 전환, 초기 결과와 재실행</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR> 결과 별도 보존</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="5" ColAddr="2" ColSpan="1" RowAddr="2" RowSpan="1" Width="22168" Height="5100" Dirty="false" Editable="true" HasMargin="true" Header="false" Protect="false"><CELLMARGIN Left="280" Right="280" Top="300" Bottom="300" /><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>초기 Temp 및 제한 환경의 접근 오류 발생. 프</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>로젝트 내부의 새 임시 경로에서 재실행하여 85</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>/113건 통과</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="5" ColAddr="0" ColSpan="1" RowAddr="3" RowSpan="1" Width="11565" Height="3600" Dirty="false" Editable="true" HasMargin="true" Header="false" Protect="false"><CELLMARGIN Left="280" Right="280" Top="300" Bottom="300" /><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>Playwright 브라우저 실</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>행 파일 없음</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="5" ColAddr="1" ColSpan="1" RowAddr="3" RowSpan="1" Width="14457" Height="3600" Dirty="false" Editable="true" HasMargin="true" Header="false" Protect="false"><CELLMARGIN Left="280" Right="280" Top="300" Bottom="300" /><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>설치된 지원 브라우저 선택 후</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR> 전체 브라우저 묶음 재실행</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="5" ColAddr="2" ColSpan="1" RowAddr="3" RowSpan="1" Width="22168" Height="3600" Dirty="false" Editable="true" HasMargin="true" Header="false" Protect="false"><CELLMARGIN Left="280" Right="280" Top="300" Bottom="300" /><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>기본 Chromium 미설치로 6건 실행 준비 실패. </CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>설치된 Edge로 재실행하여 6건 통과</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="5" ColAddr="0" ColSpan="1" RowAddr="4" RowSpan="1" Width="11565" Height="5100" Dirty="false" Editable="true" HasMargin="true" Header="false" Protect="false"><CELLMARGIN Left="280" Right="280" Top="300" Bottom="300" /><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>시험 DB가 실사용 이력</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>과 혼용되거나 외부 운</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>영 DB로 연결됨</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="5" ColAddr="1" ColSpan="1" RowAddr="4" RowSpan="1" Width="14457" Height="5100" Dirty="false" Editable="true" HasMargin="true" Header="false" Protect="false"><CELLMARGIN Left="280" Right="280" Top="300" Bottom="300" /><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>임시 SQLite 및 합성 기기만 사</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>용하는 설정 확인</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="5" ColAddr="2" ColSpan="1" RowAddr="4" RowSpan="1" Width="22168" Height="5100" Dirty="false" Editable="true" HasMargin="true" Header="false" Protect="false"><CELLMARGIN Left="280" Right="280" Top="300" Bottom="300" /><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>Backend·브라우저 시험을 별도 임시 SQLite로 </CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>격리. 외부 운영 DB 미사용</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="5" ColAddr="0" ColSpan="1" RowAddr="5" RowSpan="1" Width="11565" Height="5100" Dirty="false" Editable="true" HasMargin="true" Header="false" Protect="false"><CELLMARGIN Left="280" Right="280" Top="300" Bottom="300" /><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>인증 없이 조회되거나 </CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>타 기기 데이터가 노출</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>됨</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="5" ColAddr="1" ColSpan="1" RowAddr="5" RowSpan="1" Width="14457" Height="5100" Dirty="false" Editable="true" HasMargin="true" Header="false" Protect="false"><CELLMARGIN Left="280" Right="280" Top="300" Bottom="300" /><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>접근 제어 수정 및 관련 권한·</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>삭제 회귀 시험 전체 통과</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="5" ColAddr="2" ColSpan="1" RowAddr="5" RowSpan="1" Width="22168" Height="5100" Dirty="false" Editable="true" HasMargin="true" Header="false" Protect="false"><CELLMARGIN Left="280" Right="280" Top="300" Bottom="300" /><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>이번 실행에서 해당 실패 없음</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="5" ColAddr="0" ColSpan="1" RowAddr="6" RowSpan="1" Width="11565" Height="5100" Dirty="false" Editable="true" HasMargin="true" Header="false" Protect="false"><CELLMARGIN Left="280" Right="280" Top="300" Bottom="300" /><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>무한 대기·서버 종료·손</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>상된 저장으로 후속 결</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>과 신뢰 불가</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="5" ColAddr="1" ColSpan="1" RowAddr="6" RowSpan="1" Width="14457" Height="5100" Dirty="false" Editable="true" HasMargin="true" Header="false" Protect="false"><CELLMARGIN Left="280" Right="280" Top="300" Bottom="300" /><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>원인 해결·시험 환경 재구성 후</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR> 영향 시나리오 재실행</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="5" ColAddr="2" ColSpan="1" RowAddr="6" RowSpan="1" Width="22168" Height="5100" Dirty="false" Editable="true" HasMargin="true" Header="false" Protect="false"><CELLMARGIN Left="280" Right="280" Top="300" Bottom="300" /><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>해당 중단 없음. 브라우저 시험은 시나리오당 제</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>한 45초 적용</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="5" ColAddr="0" ColSpan="1" RowAddr="7" RowSpan="1" Width="11565" Height="3600" Dirty="false" Editable="true" HasMargin="true" Header="false" Protect="false"><CELLMARGIN Left="280" Right="280" Top="300" Bottom="300" /><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>실제 가격·LLM·이벤트 </CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>제공자가 준비되지 않음</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="5" ColAddr="1" ColSpan="1" RowAddr="7" RowSpan="1" Width="14457" Height="3600" Dirty="false" Editable="true" HasMargin="true" Header="false" Protect="false"><CELLMARGIN Left="280" Right="280" Top="300" Bottom="300" /><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>설정·실행 상태를 확보하고 미</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>실시 케이스를 별도로 수행</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="5" ColAddr="2" ColSpan="1" RowAddr="7" RowSpan="1" Width="22168" Height="3600" Dirty="false" Editable="true" HasMargin="true" Header="false" Protect="false"><CELLMARGIN Left="280" Right="280" Top="300" Bottom="300" /><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>실제 외부 서비스 시험은 제외. 모의 입력 통과</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>를 실연동 통과로 대체하지 않음</CHAR></TEXT></P></PARALIST></CELL></ROW></TABLE></TEXT></P><P ParaShape="37" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="41"><CHAR /></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>초기 준비 오류는 실행 환경 문제로 기록한다. 최종 통과 로그와 구분하여 보관하며, 오류가 없었던 것으로 </CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>삭제하거나 최종 제품 결함 수에 혼합하지 않는다. 애플리케이션 코드를 수정하여 시험을 통과시킨 내역은 </CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>없다.</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>시험 데이터 취급</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>• 시험 기기 이름·프로세스·상품·측정값은 합성 자료를 사용한다.</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>• 시험 연결키는 실행 중 생성하고 연결 해제 시 폐기한다. 실제 사용자 키·DB 접속 문자열·API 비밀키는 문</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>서에 포함하지 않는다.</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>• 실제 Sysmon 설치, UAC 승인, 상시 모니터링, 외부 서버 배포 및 유료 API 호출은 이번 작업에서 수행하</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>지 않았다.</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>• 최초 환경 오류 및 최종 결과의 파일명은 7절과 시험 근거 목록에 기록한다.</CHAR></TEXT></P><P ParaShape="37" Style="0" PageBreak="true" ColumnBreak="false"><TEXT CharShape="41"><CHAR /></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="36"><CHAR>5. 테스트 환경</CHAR></TEXT></P><P ParaShape="37" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="41"><CHAR /></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="37"><CHAR>5.1 HW 테스트 환경 구성</CHAR></TEXT></P><P ParaShape="37" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="41"><CHAR /></TEXT></P><P ParaShape="38" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><PICTURE Reverse="false"><SHAPEOBJECT InstId="400013" Lock="false" NumberingType="Figure" ZOrder="4"><SIZE Height="18071" HeightRelTo="Absolute" Protect="false" Width="48190" WidthRelTo="Absolute" /><POSITION AffectLSpacing="false" AllowOverlap="false" FlowWithText="true" HoldAnchorAndSO="false" HorzAlign="Left" HorzOffset="0" HorzRelTo="Para" TreatAsChar="true" VertAlign="Top" VertOffset="0" VertRelTo="Para" /><OUTSIDEMARGIN Bottom="0" Left="0" Right="0" Top="0" /><SHAPECOMMENT>test-env.png</SHAPECOMMENT></SHAPEOBJECT><SHAPECOMPONENT CurHeight="18071" CurWidth="48190" GroupLevel="0" HorzFlip="false" InstID="1400013" OriHeight="56250" OriWidth="150000" VertFlip="false" XPos="0" YPos="0"><ROTATIONINFO Angle="0" CenterX="24095" CenterY="9035" Rotate="1" /><RENDERINGINFO><TRANSMATRIX E1="1.00000" E2="0.00000" E3="0.00000" E4="0.00000" E5="1.00000" E6="0.00000" /><SCAMATRIX E1="0.32126666666666664" E2="0.00000" E3="0.00000" E4="0.00000" E5="0.3212622222222222" E6="0.00000" /><ROTMATRIX E1="1.00000" E2="0.00000" E3="0.00000" E4="0.00000" E5="1.00000" E6="0.00000" /></RENDERINGINFO></SHAPECOMPONENT><IMAGERECT X0="0" X1="150000" X2="150000" X3="0" Y0="0" Y1="0" Y2="56250" Y3="56250" /><IMAGECLIP Bottom="56250" Left="0" Right="150000" Top="0" /><INSIDEMARGIN Bottom="0" Left="0" Right="0" Top="0" /><IMAGEDIM Height="56250" Width="150000" /><IMAGE Alpha="0" BinItem="1" Bright="0" Contrast="0" Effect="RealPic" /><EFFECTS /></PICTURE></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="35"><CHAR>그림 1. 시험 환경 구성도. 웹·API·DB를 하나의 호스트에 배치한 로컬 기능 검증 환경이다. 운영 배포의 네</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="35"><CHAR>트워크 성능·용량을 재현하지 않는다.</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="35"><CHAR>표 8. HW 테스트 환경</CHAR></TEXT></P><P ParaShape="37" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><TABLE BorderFill="4" CellSpacing="0" ColCount="3" RowCount="4" PageBreak="Cell" RepeatHeader="true"><SHAPEOBJECT InstId="400014" Lock="false" NumberingType="Table" ZOrder="0"><SIZE Width="48190" Height="12900" WidthRelTo="Absolute" HeightRelTo="Absolute" Protect="false" /><POSITION TreatAsChar="true" AffectLSpacing="false" FlowWithText="true" AllowOverlap="false" HoldAnchorAndSO="false" HorzAlign="Left" HorzOffset="0" HorzRelTo="Column" VertAlign="Top" VertOffset="0" VertRelTo="Para" /><OUTSIDEMARGIN Left="0" Right="0" Top="0" Bottom="0" /></SHAPEOBJECT><INSIDEMARGIN Left="280" Right="280" Top="300" Bottom="300" /><ROW><CELL BorderFill="7" ColAddr="0" ColSpan="1" RowAddr="0" RowSpan="1" Width="11565" Height="2100" Dirty="false" Editable="true" HasMargin="true" Header="true" Protect="false"><CELLMARGIN Left="280" Right="280" Top="300" Bottom="300" /><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="35"><CHAR>역할</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="7" ColAddr="1" ColSpan="1" RowAddr="0" RowSpan="1" Width="14457" Height="2100" Dirty="false" Editable="true" HasMargin="true" Header="true" Protect="false"><CELLMARGIN Left="280" Right="280" Top="300" Bottom="300" />