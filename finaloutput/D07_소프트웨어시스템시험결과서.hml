er="false" Protect="false"><CELLMARGIN Left="280" Right="280" Top="300" Bottom="300" /><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>직접 접근·통신 </CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>실패·빈 검색</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="5" ColAddr="2" ColSpan="1" RowAddr="2" RowSpan="1" Width="15420" Height="6600" Dirty="false" Editable="true" HasMargin="true" Header="false" Protect="false"><CELLMARGIN Left="280" Right="280" Top="300" Bottom="300" /><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>/purchase.html 직접 접근. 상품 </CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>요청 중단. DDR5 메모리 16GB </CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>입력 후 검색, 이어서 공백 3개 </CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>입력</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="5" ColAddr="3" ColSpan="1" RowAddr="2" RowSpan="1" Width="15904" Height="6600" Dirty="false" Editable="true" HasMargin="true" Header="false" Protect="false"><CELLMARGIN Left="280" Right="280" Top="300" Bottom="300" /><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>최초 쇼핑 링크 숨김. 장애 시 쇼</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>핑몰 검색으로 계속 진행 안내와 </CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>링크 제공. 공백 검색 시 상품명/</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>규격 입력 안내, 쇼핑 링크 숨김</CHAR></TEXT></P></PARALIST></CELL></ROW></TABLE></TEXT></P><P ParaShape="37" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="41"><CHAR /></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>STC-MON-001은 웹·실제 로컬 API·SQLite를 통합하여 실행했다. STC-MON-003은 실제 로컬 연결/동의 API</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>를 사용했다. STC-BUY-004~006은 네트워크 응답을 통제한 브라우저 흐름 시험이다. 따라서 판매처 구매·결</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>제 또는 실제 상품 재고를 검증하지 않았다.</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="35"><CHAR>표 5. Backend·Agent 보조 검증 대표 케이스</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>아래 ATC 항목은 시스템 시나리오의 근거를 보강하는 기존 API·단위 시험이다. STC 6건에 더하여 시스템 시</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>험 건수로 재계산하지 않는다. 전체 개별 항목 목록은 부록의 시험 근거 목록을 따른다.</CHAR></TEXT></P><P ParaShape="37" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><TABLE BorderFill="4" CellSpacing="0" ColCount="3" RowCount="9" PageBreak="Cell" RepeatHeader="true"><SHAPEOBJECT InstId="400008" Lock="false" NumberingType="Table" ZOrder="0"><SIZE Width="48190" Height="32400" WidthRelTo="Absolute" HeightRelTo="Absolute" Protect="false" /><POSITION TreatAsChar="true" AffectLSpacing="false" FlowWithText="true" AllowOverlap="false" HoldAnchorAndSO="false" HorzAlign="Left" HorzOffset="0" HorzRelTo="Column" VertAlign="Top" VertOffset="0" VertRelTo="Para" /><OUTSIDEMARGIN Left="0" Right="0" Top="0" Bottom="0" /></SHAPEOBJECT><INSIDEMARGIN Left="280" Right="280" Top="300" Bottom="300" /><ROW><CELL BorderFi