="false"><TEXT CharShape="34"><CHAR>미수집 온도, 상품 제공자 오류</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>, 빈 검색</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="5" ColAddr="2" ColSpan="1" RowAddr="5" RowSpan="1" Width="22168" Height="3600" Dirty="false" Editable="true" HasMargin="true" Header="false" Protect="false"><CELLMARGIN Left="280" Right="280" Top="300" Bottom="300" /><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>결측 안내 및 복구 경로 표시. 신규 구매 경로에 </CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>허위 상품 생성 없음</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="5" ColAddr="0" ColSpan="1" RowAddr="6" RowSpan="1" Width="11565" Height="3600" Dirty="false" Editable="true" HasMargin="true" Header="false" Protect="false"><CELLMARGIN Left="280" Right="280" Top="300" Bottom="300" /><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>최종 시스템 종료 조건</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="5" ColAddr="1" ColSpan="1" RowAddr="6" RowSpan="1" Width="14457" Height="3600" Dirty="false" Editable="true" HasMargin="true" Header="false" Protect="false"><CELLMARGIN Left="280" Right="280" Top="300" Bottom="300" /><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>실환경 필수 시험 완료, 중요 </CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>미해결 항목 해소, 검토자 승인</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="5" ColAddr="2" ColSpan="1" RowAddr="6" RowSpan="1" Width="22168" Height=