wAddr="5" RowSpan="1" Width="37107" Height="2100" Dirty="false" Editable="true" HasMargin="true" Header="false" Protect="false"><CELLMARGIN Left="280" Right="280" Top="300" Bottom="300" /><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>2026년 11월 17일</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="5" ColAddr="0" ColSpan="1" RowAddr="6" RowSpan="1" Width="11083" Height="2100" Dirty="false" Editable="true" HasMargin="true" Header="false" Protect="false"><CELLMARGIN Left="280" Right="280" Top="300" Bottom="300" /><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>기준 소스</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="5" ColAddr="1" ColSpan="1" RowAddr="6" RowSpan="1" Width="37107" Height="2100" Dirty="false" Editable="true" HasMargin="true" Header="false" Protect="false"><CELLMARGIN Left="280" Right="280" Top="300" Bottom="300" /><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>Git 커밋 30ebb01 / github.com/wootaehyeon/SpecCheck</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="5" ColAddr="0" ColSpan="1" RowAddr="7" RowSpan="1" Width="11083" Height="2100" Dirty="false" Editable="true" HasMargin="true" Header="false" Protect="false"><CELLMARGIN Left="280" Right="280" Top="300" Bottom="300" /><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>작성자 / 시험 검토자</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="5" ColAddr="1" ColSpan="1" RowAddr="7" RowSpan="1" Width="37107" Height="2100" Dirty="false" Editable="true" HasMargin="true" Header="false" Protect="false"><CELLMARGIN Left="280" Right="280" Top="300" Bottom="300" /><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR> / </CHAR></TEXT></P></PARALIST></CELL></ROW></TABLE></TEXT></P><P ParaShape="37" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="41"><CHAR /></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="37"><CHAR>결과 요약</CHAR></TEXT></P><P ParaShape="37" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="41"><CHAR /></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>Agent 85건, Backend 113건, 브라우저 6개 시나리오가 통과했다. 합계 204건은 서로 다른 수준의 자동화 항</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>목이다. 실제 Windows 수집부터 외부 운영 DB·상품 제공자까지의 전 구간 검증 결과로 해석하지 않는다.</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>기존 견적 화면의 고정 점수·예시 가격 대체와 실환경 미검증 항목이 남아 전체 시스템 최종 합격 판정은 보</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>류한다. 작성일 기준 결과이며 개발 종료일의 인수 실적이 아니다.</CHAR></TEXT></P><P ParaShape="37" Style="0" PageBreak="true" ColumnBreak="false"><TEXT CharShape="41"><CHAR /></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="36"><CHAR>목차</CHAR></TEXT></P><P ParaShape="37" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="41"><CHAR /></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>1. 프로젝트 개요  .......................................................  3</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>2. 테스트 개요  .......................................................  4</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>3. 테스트 케이스  .......................................................  6</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>4. 테스트 예외사항  .......................................................  10</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>5. 테스트 환경  .......................................................  11</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>6. 테스트 결과  .......................................................  13</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>7. 부록  .......................................................  16</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>표·그림은 본문 번호를 따른다. 모든 페이지 하단에 실제 쪽 번호를 표시한다. 시험 결과·입력·출력·제한과 증</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>빙을 함께 확인한다.</CHAR></TEXT></P><P ParaShape="37" Style="0" PageBreak="true" ColumnBreak="false"><TEXT CharShape="41"><CHAR /></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="36"><CHAR>1. 프로젝트 개요</CHAR></TEXT></P><P ParaShape="37" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="41"><CHAR /></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="37"><CHAR>1.1 시스템 명</CHAR></TEXT></P><P ParaShape="37" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="41"><CHAR /></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>• 국문: SpecCheck: PC 상태 진단 및 구매 의사결정 지원 시스템</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>• 영문: SpecCheck: PC Health Diagnosis and Purchase Decision Support System</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="37"><CHAR>1.2 시스템 개요</CHAR></TEXT></P><P ParaShape="37" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="41"><CHAR /></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>• Windows Local Agent가 하드웨어·성능·저장장치 건강도·신뢰성 이벤트를 수집한다. Sysmon은 설치 및 별</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>도 동의 조건에서 최소 이벤트 정보를 추가 수집한다.</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>• Agent는 수집 결과를 버전 있는 JSON 스냅샷으로 만들고 로컬 SQLite에 저장한다. 사용자 옵션에 따라 B</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>ackend에 전송한다.</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>• Backend는 확보한 데이터에 19개 진단 규칙을 적용한다. 각 결과에는 규칙 ID, 근거, 심각도, 권고 조치가 </CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>포함되며, 종합 조치는 keep, fix, purchase로 구분한다.</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>• 공개 모니터링은 기기 조회키와 전송키를 분리한다. 하드웨어·성능·선택적 보안 섹션을 받아 최신 상태, 사</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>용률 이력, 프로세스 이벤트 및 진단을 웹에 제공한다.</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>• 구매 화면은 구매 권고 진단과 관련 사양을 표시하고, 상품 검색·판매처 링크를 제공한다. 상품 정보 미설</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>정·장애 시 별도 안내와 쇼핑 검색 링크를 표시한다.</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>• 별도의 견적 평가 API는 CPU/GPU 벤치마크, 간이 호환성 및 위험도 계산을 제공한다. 기존 견적 화면은 </CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>일부 예시 점수·가격 대체 로직을 포함하므로 이 API와 전 구간 통합이 완료된 것으로 간주하지 않는다.</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>사용자 흐름</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="40"><CHAR>PC 연결 및 수집·전송 동의 → Agent 설정 다운로드 → Windows Agent 실행</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="40"><CHAR>→ 스냅샷 업로드 → 규칙 진단 → 웹 상태·근거 확인</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="40"><CHAR>→ 유지 / 설정 수정 / 구매 대상 확인 → 필요 시 상품 검색 및 판매처 이동</CHAR></TEXT></P><P ParaShape="37" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="41"><CHAR /></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>판정 해석의 범위</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>• ‘이상 징후 없음’은 확보한 섹션과 등록 규칙에서 조치할 항목이 발견되지 않았다는 의미다. PC 전체의 건</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>강·보안을 보증하지 않는다.</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>• 온도 센서 미지원, 권한 부족, 로그 누락은 정상 수치로 대체하지 않고 수집 상태와 결측으로 표시한다.</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>• 진단 confidence는 검증된 정확도 지표가 아니다. 확보된 섹션과 규칙 설계를 반영한 참고값이다.</CHAR></TEXT></P><P ParaShape="37" Style="0" PageBreak="true" ColumnBreak="false"><TEXT CharShape="41"><CHAR /></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="36"><CHAR>2. 테스트 개요</CHAR></TEXT></P><P ParaShape="37" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="41"><CHAR /></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="37"><CHAR>2.1 테스트 범위</CHAR></TEXT></P><P ParaShape="37" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="41"><CHAR /></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>본 문서의 시스템 수준 시험은 브라우저를 통한 연결·조회·구매 흐름 6개 시나리오로 구성한다. 기존 Agent </CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>및 Backend 자동화 시험은 하위 계층의 보조 검증 근거로 첨부하며 시스템 시험 건수와 별도로 집계한다. </CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>서비스 소스와 시험 코드의 변경 없이 실행 환경을 조정해 기존 시험을 수행했다.</CHAR></TEXT></P><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="35"><CHAR>표 1. 기능별 검증 범위 및 제한</CHAR></TEXT></P><P ParaShape="37" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><TABLE BorderFill="4" CellSpacing="0" ColCount="4" RowCount="11" PageBreak="Cell" RepeatHeader="true"><SHAPEOBJECT InstId="400002" Lock="false" NumberingType="Table" ZOrder="0"><SIZE Width="48190" Height="51600" WidthRelTo="Absolute" HeightRelTo="Absolute" Protect="false" /><POSITION TreatAsChar="true" AffectLSpacing="false" FlowWithText="true" AllowOverlap="false" HoldAnchorAndSO="false" HorzAlign="Left" HorzOffset="0" HorzRelTo="Column" VertAlign="Top" VertOffset="0" VertRelTo="Para" /><OUTSIDEMARGIN Left="0" Right="0" Top="0" Bottom="0" /></SHAPEOBJECT><INSIDEMARGIN Left="280" Right="280" Top="300" Bottom="300" /><ROW><CELL BorderFill="7" ColAddr="0" ColSpan="1" RowAddr="0" RowSpan="1" Width="10601" Height="2100" Dirty="false" Editable="true" HasMargin="true" Header="true" Protect="false"><CELLMARGIN Left="280" Right="280" Top="300" Bottom="300" /><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="35"><CHAR>식별자</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="7" ColAddr="1" ColSpan="1" RowAddr="0" RowSpan="1" Width="13493" Height="2100" Dirty="false" Editable="true" HasMargin="true" Header="true" Protect="false"><CELLMARGIN Left="280" Right="280" Top="300" Bottom="300" /><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="35"><CHAR>기능 / 요구사항 그룹</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="7" ColAddr="2" ColSpan="1" RowAddr="0" RowSpan="1" Width="15420" Height="2100" Dirty="false" Editable="true" HasMargin="true" Header="true" Protect="false"><CELLMARGIN Left="280" Right="280" Top="300" Bottom="300" /><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="35"><CHAR>이번 확인 범위</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="7" ColAddr="3" ColSpan="1" RowAddr="0" RowSpan="1" Width="8676" Height="2100" Dirty="false" Editable="true" HasMargin="true" Header="true" Protect="false"><CELLMARGIN Left="280" Right="280" Top="300" Bottom="300" /><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="35"><CHAR>실환경 제한</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="5" ColAddr="0" ColSpan="1" RowAddr="1" RowSpan="1" Width="10601" Height="5100" Dirty="false" Editable="true" HasMargin="true" Header="false" Protect="false"><CELLMARGIN Left="280" Right="280" Top="300" Bottom="300" /><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="35" Style="0" PageBreak="false" ColumnBreak="false"><TEXT CharShape="34"><CHAR>SC-R01</CHAR></TEXT></P></PARALIST></C