"Center"><P ParaShape="14" Style="0"><TEXT CharShape="9"><CHAR>Backend(SQLite 등)</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="4" ColAddr="1" ColSpan="1" Dirty="false" Editable="true" HasMargin="true" Header="false" Height="2100" Protect="false" RowAddr="2" RowSpan="1" Width="12756"><CELLMARGIN Bottom="300" Left="280" Right="280" Top="300"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="14" Style="0"><TEXT CharShape="9"><CHAR>295</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="4" ColAddr="2" ColSpan="1" Dirty="false" Editable="true" HasMargin="true" Header="false" Height="2100" Protect="false" RowAddr="2" RowSpan="1" Width="19560"><CELLMARGIN Bottom="300" Left="280" Right="280" Top="300"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="14" Style="0"><TEXT CharShape="9"><CHAR>backend.xml, backend.log</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="4" ColAddr="0" ColSpan="1" Dirty="false" Editable="true" HasMargin="true" Header="false" Height="3600" Protect="false" RowAddr="3" RowSpan="1" Width="10204"><CELLMARGIN Bottom="300" Left="280" Right="280" Top="300"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="14" Style="0"><TEXT CharShape="9"><CHAR>PostgreSQL 별도 파</CHAR></TEXT></P><P ParaShape="14" Style="0"><TEXT CharShape="9"><CHAR>라미터</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="4" ColAddr="1" ColSpan="1" Dirty="false" Editable="true" HasMargin="true" Header="false" Height="3600" Protect="false" RowAddr="3" RowSpan="1" Width="12756"><CELLMARGIN Bottom="300" Left="280" Right="280" Top="300"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="14" Style="0"><TEXT CharShape="9"><CHAR>15</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="4" ColAddr="2" ColSpan="1" Dirty="false" Editable="true" HasMargin="true" Header="false" Height="3600" Protect="false" RowAddr="3" RowSpan="1" Width="19560"><CELLMARGIN Bottom="300" Left="280" Right="280" Top="300"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="14" Style="0"><TEXT CharShape="9"><CHAR>postgres.xml, postgres.log</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="4" ColAddr="0" ColSpan="1" Dirty="false" Editable="true" HasMargin="true" Header="false" Height="2100" Protect="false" RowAddr="4" RowSpan="1" Width="10204"><CELLMARGIN Bottom="300" Left="280" Right="280" Top="300"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="14" Style="0"><TEXT CharShape="9"><CHAR>UI 로직</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="4" ColAddr="1" ColSpan="1" Dirty="false" Editable="true" HasMargin="true" Header="false" Height="2100" Protect="false" RowAddr="4" RowSpan="1" Width="12756"><CELLMARGIN Bottom="300" Left="280" Right="280" Top="300"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="14" Style="0"><TEXT CharShape="9"><CHAR>53</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="4" ColAddr="2" ColSpan="1" Dirty="false" Editable="true" HasMargin="true" Header="false" Height="2100" Protect="false" RowAddr="4" RowSpan="1" Width="19560"><CELLMARGIN Bottom="300" Left="280" Right="280" Top="300"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="14" Style="0"><TEXT CharShape="9"><CHAR>ui.log</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="4" ColAddr="0" ColSpan="1" Dirty="false" Editable="true" HasMargin="true" Header="false" Height="2100" Protect="false" RowAddr="5" RowSpan="1" Width="10204"><CELLMARGIN Bottom="300" Left="280" Right="280" Top="300"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="14" Style="0"><TEXT CharShape="9"><CHAR>Edge 브라우저</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="4" ColAddr="1" ColSpan="1" Dirty="false" Editable="true" HasMargin="true" Header="false" Height="2100" Protect="false" RowAddr="5" RowSpan="1" Width="12756"><CELLMARGIN Bottom="300" Left="280" Right="280" Top="300"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="14" Style="0"><TEXT CharShape="9"><CHAR>15</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="4" ColAddr="2" ColSpan="1" Dirty="false" Editable="true" HasMargin="true" Header="false" Height="2100" Protect="false" RowAddr="5" RowSpan="1" Width="19560"><CELLMARGIN Bottom="300" Left="280" Right="280" Top="300"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="14" Style="0"><TEXT CharShape="9"><CHAR>browser.json, browser.log</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="4" ColAddr="0" ColSpan="1" Dirty="false" Editable="true" HasMargin="true" Header="false" Height="2100" Protect="false" RowAddr="6" RowSpan="1" Width="10204"><CELLMARGIN Bottom="300" Left="280" Right="280" Top="300"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="14" Style="0"><TEXT CharShape="9"><CHAR>참고 합계</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="4" ColAddr="1" ColSpan="1" Dirty="false" Editable="true" HasMargin="true" Header="false" Height="2100" Protect="false" RowAddr="6" RowSpan="1" Width="12756"><CELLMARGIN Bottom="300" Left="280" Right="280" Top="300"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="14" Style="0"><TEXT CharShape="9"><CHAR>503</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="4" ColAddr="2" ColSpan="1" Dirty="false" Editable="true" HasMargin="true" Header="false" Height="2100" Protect="false" RowAddr="6" RowSpan="1" Width="19560"><CELLMARGIN Bottom="300" Left="280" Right="280" Top="300"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="14" Style="0"><TEXT CharShape="9"><CHAR>자동화시험목록.md</CHAR></TEXT></P></PARALIST></CELL></ROW></TABLE><CHAR/></TEXT></P><P ParaShape="15" Style="0"><TEXT CharShape="14"/></P><P ParaShape="14" Style="0"><TEXT CharShape="9"><CHAR>실패·오류·skipped는 0건이다. PostgreSQL 실행의 deselected 15건은 선택식에서 제외한 SQL</CHAR></TEXT></P><P ParaShape="14" Style="0"><TEXT CharShape="9"><CHAR>ite 파라미터이며 Backend 실행에 포함됐다. lint와 TypeScript 검사도 통과했다. 서로 다른 계</CHAR></TEXT></P><P ParaShape="14" Style="0"><TEXT CharShape="9"><CHAR>층의 시험을 더한 503은 시스템 인수율이나 진단 정확도가 아니다. 11월 5일의 204건 및 이</CHAR></TEXT></P><P ParaShape="14" Style="0"><TEXT CharShape="9"><CHAR>전 회귀 53·5·15건을 중복 합산하지 않는다. Backend 의존성의 사용 중단 예정 경고 2건은 남</CHAR></TEXT></P><P ParaShape="14" Style="0"><TEXT CharShape="9"><CHAR>아 있다.</CHAR></TEXT></P><P ParaShape="14" Style="0"><TEXT CharShape="9"><CHAR>등록 사례는 시스템 시나리오 14건과 자동화 대응 사례 22건, 총 36건이다. P 32건, B 4건, F </CHAR></TEXT></P><P ParaShape="14" Style="0"><TEXT CharShape="9"><CHAR>0건, NT 0건으로 수행 완료는 88.9%다. B는 선행 조건 확인·하위 시험을 수행했으나 원래 범</CHAR></TEXT></P><P ParaShape="14" Style="0"><TEXT CharShape="9"><CHAR>위가 차단된 사례다. 시스템 시나리오만의 완료는 10/14건(71.4%)이다. 환경 차단 4건을 통과</CHAR></TEXT></P><P ParaShape="14" Style="0"><TEXT CharShape="9"><CHAR>로 합산하지 않는다.</CHAR></TEXT></P><P ParaShape="14" Style="0"><TEXT CharShape="12"><CHAR>4.2 실제 수집·통합 및 반복 전송</CHAR></TEXT></P><P ParaShape="15" Style="0"><TEXT CharShape="14"/></P><P ColumnBreak="false" PageBreak="true" ParaShape="15" Style="0"><TEXT CharShape="14"/></P><P ParaShape="14" Style="0"><TEXT CharShape="12"><CHAR>4. 개발 결과 및 검증 근거 (계속)</CHAR></TEXT></P><P ParaShape="14" Style="0"><TEXT CharShape="9"><CHAR>• 실기기 수집(STC-REAL-007): 실제 Windows Basic Scan 종료 0, 로컬 업로드 201·조회 200·</CHAR></TEXT></P><P ParaShape="14" Style="0"><TEXT CharShape="9"><CHAR>진단 200을 확인했다. hardware/reliability/performance는 ok, 저장장치·보안과 일부 분석은 </CHAR></TEXT></P><P ParaShape="14" Style="0"><TEXT CharShape="9"><CHAR>partial이었다. 원본과 재조회가 일치했고 결측을 보존했다. 온도·관리자 SMART 수집 성공으</CHAR></TEXT></P><P ParaShape="14" Style="0"><TEXT CharShape="9"><CHAR>로 계산하지 않는다.</CHAR></TEXT></P><P ParaShape="14" Style="0"><TEXT CharShape="9"><CHAR>• 전송·저장: 기존 로컬 HTTPS·격리 PostgreSQL 17·Edge 측정값 표시 및 재시작·삭제 증빙을 </CHAR></TEXT></P><P ParaShape="14" Style="0"><TEXT CharShape="9"><CHAR>확인했다. 공개 Render HTTPS의 업로드 201·조회 200·새로고침 유지·시험 연결 삭제 증빙도 </CHAR></TEXT></P><P ParaShape="14" Style="0"><TEXT CharShape="9"><CHAR>별도로 존재한다. 외부 운영 DB 엔진과 서버·DB 재시작 인수는 아직 차단 상태다.</CHAR></TEXT></P><P ParaShape="14" Style="0"><TEXT CharShape="9"><CHAR>• 견적·조립(STC-REAL-012/013): API 계산값과 상세 화면의 호환성 메시지 일치, 미등록 모델 </CHAR></TEXT></P><P ParaShape="14" Style="0"><TEXT CharShape="9"><CHAR>표시 보류, 가격 실패 시 예시값 미사용을 확인했다. Canvas의 보드→CPU→쿨러 장착 및 역</CHAR></TEXT></P><P ParaShape="14" Style="0"><TEXT CharShape="9"><CHAR>순 해제를 시험했다. 실제 모든 부품 조합의 물리 호환성 보증은 아니다.</CHAR></TEXT></P><P ParaShape="14" Style="0"><TEXT CharShape="9"><CHAR>• 반복 전송(STC-REAL-014): 격리 PostgreSQL에서 합성 기기 10대, 30초 간격 21회, 600.14초</CHAR></TEXT></P><P ParaShape="14" Style="0"><TEXT CharShape="9"><CHAR> 동안 고유 샘플 210개·업로드 420회를 확인했다. 누락·중복행 0, 업로드 p95 54.89ms·최대 7</CHAR></TEXT></P><P ParaShape="14" Style="0"><TEXT CharShape="9"><CHAR>7.98ms였다. 중간 Backend·DB 재시작·키 회전·종료 후 10대 삭제를 통과했다. 로컬 시험 기준</CHAR></TEXT></P><P ParaShape="14" Style="0"><TEXT CharShape="9"><CHAR>에 한정하며 24시간 운용·외부 SLA를 의미하지 않는다.</CHAR></TEXT></P><P ParaShape="14" Style="0"><TEXT CharShape="12"><CHAR>4.3 요구사항 달성 범위</CHAR></TEXT></P><P ParaShape="15" Style="0"><TEXT CharShape="14"/></P><P ParaShape="14" Style="0"><TEXT CharShape="9"><CHAR>D04의 30개 백로그를 D07에서 대조한 결과는 확인 12건·부분 14건·미충족 4건이다. 구현 유</CHAR></TEXT></P><P ParaShape="14" Style="0"><TEXT CharShape="9"><CHAR>무, 시험 수행 완료, 사람의 인수 승인을 구분한다. 미충족은 아래 네 항목이며 구체적인 인수</CHAR></TEXT></P><P ParaShape="14" Style="0"><TEXT CharShape="9"><CHAR> 기준과 근거는 D07의 백로그별 검토를 따른다.</CHAR></TEXT></P><P ParaShape="14" Style="0"><TEXT CharShape="10"><CHAR>표 11. 미충족 백로그와 보완 방향</CHAR></TEXT></P><P ParaShape="15" Style="0"><TEXT CharShape="9"><TABLE BorderFill="3" CellSpacing="0" ColCount="3" PageBreak="Cell" RepeatHeader="true" RowCount="4"><SHAPEOBJECT InstId="400025" Lock="false" NumberingType="Table" ZOrder="0"><SIZE Height="24400" HeightRelTo="Absolute" Protect="false" Width="42520" WidthRelTo="Absolute"/><POSITION AffectLSpacing="false" AllowOverlap="false" FlowWithText="true" HoldAnchorAndSO="false" HorzAlign="Left" HorzOffset="0" HorzRelTo="Column" TreatAsChar="true" VertAlign="Top" VertOffset="0" VertRelTo="Para"/><OUTSIDEMARGIN Bottom="0" Left="0" Right="0" Top="0"/></SHAPEOBJECT><INSIDEMARGIN Bottom="300" Left="280" Right="280" Top="300"/><ROW><CELL BorderFill="5" ColAddr="0" ColSpan="1" Dirty="false" Editable="true" HasMargin="true" Header="true" Height="2100" Protect="false" RowAddr="0" RowSpan="1" Width="10204"><CELLMARGIN Bottom="300" Left="280" Right="280" Top="300"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="14" Style="0"><TEXT CharShape="10"><CHAR>ID</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="5" ColAddr="1" ColSpan="1" Dirty="false" Editable="true" HasMargin="true" Header="true" Height="2100" Protect="false" RowAddr="0" RowSpan="1" Width="12756"><CELLMARGIN Bottom="300" Left="280" Right="280" Top="300"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="14" Style="0"><TEXT CharShape="10"><CHAR>미충족 내용</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="5" ColAddr="2" ColSpan="1" Dirty="false" Editable="true" HasMargin="true" Header="true" Height="2100" Protect="false" RowAddr="0" RowSpan="1" Width="19560"><CELLMARGIN Bottom="300" Left="280" Right="280" Top="300"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="14" Style="0"><TEXT CharShape="10"><CHAR>보완 방향</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="4" ColAddr="0" ColSpan="1" Dirty="false" Editable="true" HasMargin="true" Header="false" Height="6600" Protect="false" RowAddr="1" RowSpan="1" Width="10204"><CELLMARGIN Bottom="300" Left="280" Right="280" Top="300"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="14" Style="0"><TEXT CharShape="9"><CHAR>US-02</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="4" ColAddr="1" ColSpan="1" Dirty="false" Editable="true" HasMargin="true" Header="false" Height="6600" Protect="false" RowAddr="1" RowSpan="1" Width="12756"><CELLMARGIN Bottom="300" Left="280" Right="280" Top="300"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="14" Style="0"><TEXT CharShape="9"><CHAR>전체 PC 두 후보의 7종 부</CHAR></TEXT></P><P ParaShape="14" Style="0"><TEXT CharShape="9"><CHAR>품 나란히 비교 구현 근거 </CHAR></TEXT></P><P ParaShape="14" Style="0"><TEXT CharShape="9"><CHAR>없음. 단일 견적·개별 교체</CHAR></TEXT></P><P ParaShape="14" Style="0"><TEXT CharShape="9"><CHAR> 후보와 구별.</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="4" ColAddr="2" ColSpan="1" Dirty="false" Editable="true" HasMargin="true" Header="false" Height="6600" Protect="false" RowAddr="1" RowSpan="1" Width="19560"><CELLMARGIN Bottom="300" Left="280" Right="280" Top="300"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="14" Style="0"><TEXT CharShape="9"><CHAR>해당 인수 기준에 맞는 통합 경로 구현</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="4" ColAddr="0" ColSpan="1" Dirty="false" Editable="true" HasMargin="true" Header="false" Height="9600" Protect="false" RowAddr="2" RowSpan="1" Width="10204"><CELLMARGIN Bottom="300" Left="280" Right="280" Top="300"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="1