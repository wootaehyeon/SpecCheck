# Send only runtime files to Docker; exclude local scans, secrets and large outputs.
**
!Dockerfile
!backend/
!backend/requirements-web.txt
!backend/app/
!backend/app/**
!backend/data/
!backend/data/cpu_benchmark.json
!backend/data/gpu_benchmark.json
!datasets/
!datasets/*/
!datasets/*/*.csv
!frontend/
!frontend/web/
!frontend/web/**
!agent/
!agent/speccheck_agent/
!agent/speccheck_agent/**
!agent/Start-SpecCheck.cmd

**/__pycache__/
**/*.py[cod]
**/.env
**/.env.*
**/*.env
**/*.db
**/*.db-*
**/*.snapshot.json
