{
  "$defs": {
    "CollectionConsent": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "sysmon-minimal-v1",
          "enum": [
            "sysmon-minimal-v1"
          ],
          "title": "Version",
          "type": "string"
        },
        "granted_at": {
          "format": "date-time",
          "title": "Granted At",
          "type": "string"
        }
      },
      "required": [
        "version",
        "granted_at"
      ],
      "title": "CollectionConsent",
      "type": "object"
    },
    "ProcessEvent": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "enum": [
            1,
            5,
            25,
            255
          ],
          "title": "Event Id",
          "type": "integer"
        },
        "record_id": {
          "minimum": 1,
          "title": "Record Id",
          "type": "integer"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "process_guid": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Process Guid"
        },
        "process_id": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Process Id"
        },
        "image": {
          "anyOf": [
            {
              "maxLength": 260,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image"
        },
        "parent_process_guid": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Process Guid"
        },
        "parent_image": {
          "anyOf": [
            {
              "maxLength": 260,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Image"
        }
      },
      "required": [
        "event_id",
        "record_id",
        "occurred_at"
      ],
      "title": "ProcessEvent",
      "type": "object"
    },
    "DefenderState": {
      "additionalProperties": false,
      "properties": {
        "antivirus_enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Antivirus Enabled"
        },
        "realtime_enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Realtime Enabled"
        }
      },
      "title": "DefenderState",
      "type": "object"
    },
    "EventBucket": {
      "additionalProperties": false,
      "properties": {
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "process_key": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Process Key"
        },
        "kind": {
          "default": "sysmon",
          "enum": [
            "sysmon",
            "whea",
            "disk",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "event_id": {
          "title": "Event Id",
          "type": "integer"
        },
        "count": {
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        }
      },
      "required": [
        "timestamp",
        "event_id",
        "count"
      ],
      "title": "EventBucket",
      "type": "object"
    },
    "ProtectionState": {
      "additionalProperties": false,
      "properties": {
        "defender": {
          "$ref": "#/$defs/DefenderState"
        },
        "tpm_enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tpm Enabled"
        },
        "secure_boot": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Secure Boot"
        }
      },
      "title": "ProtectionState",
      "type": "object"
    },
    "SysmonAggregate": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "ok",
            "skipped",
            "error"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "reason_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason Code"
        },
        "setup_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Setup Status"
        },
        "window_start": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Window Start"
        },
        "window_end": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Window End"
        },
        "counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Counts",
          "type": "object"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        },
        "rejected_events": {
          "default": 0,
          "minimum": 0,
          "title": "Rejected Events",
          "type": "integer"
        },
        "buckets": {
          "items": {
            "$ref": "#/$defs/EventBucket"
          },
          "maxItems": 2000,
          "title": "Buckets",
          "type": "array"
        }
      },
      "required": [
        "status"
      ],
      "title": "SysmonAggregate",
      "type": "object"
    }
  },
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "consent": {
          "$ref": "#/$defs/CollectionConsent"
        },
        "window_start": {
          "format": "date-time",
          "title": "Window Start",
          "type": "string"
        },
        "window_end": {
          "format": "date-time",
          "title": "Window End",
          "type": "string"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/ProcessEvent"
          },
          "maxItems": 2000,
          "title": "Events",
          "type": "array"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        },
        "log_gap": {
          "title": "Log Gap",
          "type": "boolean"
        },
        "log_reset": {
          "title": "Log Reset",
          "type": "boolean"
        },
        "log_oldest_at": {
          "format": "date-time",
          "title": "Log Oldest At",
          "type": "string"
        }
      },
      "required": [
        "consent",
        "window_start",
        "window_end",
        "events",
        "truncated",
        "log_gap",
        "log_reset",
        "log_oldest_at"
      ],
      "title": "SecurityData",
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Basic Scan aggregates remain separate from consented process history.",
      "properties": {
        "sysmon": {
          "$ref": "#/$defs/SysmonAggregate"
        },
        "security_state": {
          "$ref": "#/$defs/ProtectionState"
        }
      },
      "required": [
        "sysmon"
      ],
      "title": "AggregateSecurityData",
      "type": "object"
    }
  ],
  "title": "SecurityData"
}
