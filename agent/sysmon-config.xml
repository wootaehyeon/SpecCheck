<!-- Optional demo configuration. Applying it changes Windows event logging.
     Sysmon itself records sensitive fields in the Windows event log; the agent
     exports only hashes and counts. Review event volume before deployment.
     Schema reference: https://learn.microsoft.com/en-us/sysinternals/downloads/sysmon -->
<Sysmon schemaversion="4.90">
  <HashAlgorithms>sha256</HashAlgorithms>
  <EventFiltering>
    <RuleGroup name="SpecCheck" groupRelation="or">
      <ProcessCreate onmatch="exclude" />
      <NetworkConnect onmatch="exclude" />
      <FileCreate onmatch="exclude" />
      <RegistryEvent onmatch="exclude" />
      <DnsQuery onmatch="exclude" />
    </RuleGroup>
  </EventFiltering>
</Sysmon>
